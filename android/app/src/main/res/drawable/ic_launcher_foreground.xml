<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher icon: a gold magnifier over a rice-paper photo card. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- photo card -->
    <path
        android:fillColor="#F4E9D6"
        android:pathData="M28,32 L64,32 A4,4 0 0 1 68,36 L68,72 A4,4 0 0 1 64,76 L28,76 A4,4 0 0 1 24,72 L24,36 A4,4 0 0 1 28,32 Z" />
    <!-- vermilion seal -->
    <path
        android:fillColor="#C0442F"
        android:pathData="M32,68 m-4.5,0 a4.5,4.5 0 1 0 9,0 a4.5,4.5 0 1 0 -9,0" />
    <!-- ruled lines on the card -->
    <path
        android:strokeColor="#C9B894"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M32,44 L60,44 M32,52 L54,52 M32,60 L48,60" />
    <!-- magnifier lens -->
    <path
        android:strokeColor="#D9A441"
        android:strokeWidth="5.5"
        android:fillColor="#00000000"
        android:pathData="M64,52 m-16,0 a16,16 0 1 0 32,0 a16,16 0 1 0 -32,0" />
    <!-- magnifier handle -->
    <path
        android:strokeColor="#D9A441"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:pathData="M75,63 L84,72" />
</vector>
