# photo-hunter web app - copy to .env and adjust if needed.
# The same values are read by docker compose and by the Node server.

# --- MySQL (runs in Docker) ---
MYSQL_ROOT_PASSWORD=hunter_root
MYSQL_DATABASE=photo_hunter
MYSQL_USER=hunter
MYSQL_PASSWORD=hunter_pass

# Host port for the MySQL container. 3306 is the MySQL default, but this machine
# already has another project's container on it, so photo-hunter exposes 3307.
MYSQL_PORT=3307

# --- API server (the web app = API + SPA, served from this port) ---
PORT=8080
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=hunter
DB_PASSWORD=hunter_pass
DB_NAME=photo_hunter

# Where the chapter JSON lives (relative to web/, or absolute - the Docker
# image keeps a copy at /app/data/levels).
LEVELS_DIR=data/levels

# Game rules (錦囊 / hint economy)
START_HINTS=3
MILESTONE_EVERY=5
HINTS_PER_MILESTONE=3

# Ranking: one wrong tap costs this many milliseconds of score on the
# leaderboard (成績 = 用時 + 誤點 × 這個值).
WRONG_TAP_PENALTY_MS=3000
